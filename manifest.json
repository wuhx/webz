{
  "name": "WebArchive Mounter",
  "short_name": "WebArchive",
  "description": "Mount and view archive files locally.",
  "start_url": "index.html",
  "display": "standalone",
  "background_color": "#f5f7fa",
  "theme_color": "#4a90e2",
  "file_handlers": [
    {
      "action": "index.html",
      "accept": {
        "application/x-webz": [".webz"]
      }
    }
  ],
  "icons": [
    {
      "src": "data:image/svg+xml;base64,",
      "sizes": "192x192",
      "type": "image/svg+xml"
    },
    {
      "src": "data:image/svg+xml;base64,",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ]
}
